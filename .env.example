# Optional: override the admin page password (default is CleanerCab2026)
# VITE_ADMIN_PASSWORD=your-secret-password

# Firebase (Firestore) — required for cloud sync of admin data across devices.
# Create a web app in the Firebase console and paste the config values here.
# Leave unset to keep localStorage-only behavior.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
